{
  "name": "genckal-app",
  "version": "1.0.0",
  "description": "Kullanıcıların fiziksel verilerine ve kişisel hedeflerine dayanarak günlük kalori ve makro besin ihtiyaçlarını geleneksel ve bilimsel algoritmalarla hesaplayan bir beslenme planlayıcısıdır. Temel amaç, kullanıcılara kendi diyet süreçlerini yönetebilecekleri, verilerini kaydedip takip edebilecekleri kişiselleştirilmiş bir web paneli sunmaktır.",
  "scripts": {
    "test": "npm run test:api",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:api-parsing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/utils/*.test.mjs",
    "test:api-routes": "node --loader ./src/test/route-test-loader.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/app/api/generate-diet/route.test.mjs src/app/api/swap-food/route.test.mjs",
    "test:api": "npm run test:api-parsing && npm run test:api-routes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BorBozka/GencKal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BorBozka/GencKal/issues"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/react": "^3.0.170",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "ai": "^6.0.168",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
